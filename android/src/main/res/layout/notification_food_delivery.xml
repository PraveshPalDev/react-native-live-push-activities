<?xml version="1.0" encoding="utf-8"?>
<!-- Food Delivery Notification Layout (Swiggy/Zomato-style) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@android:color/white">
    
    <!-- Header with Restaurant -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:id="@+id/ivRestaurantLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:scaleType="centerCrop"/>
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/tvRestaurantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pizza Hut"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333333"/>
            
            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FD-12345"
                android:textSize="11sp"
                android:textColor="#999999"/>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            
            <TextView
                android:id="@+id/tvEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 min"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FF9800"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ETA"
                android:textSize="10sp"
                android:textColor="#999999"/>
        </LinearLayout>
    </LinearLayout>
    
    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:layout_marginTop="6dp"
        android:text="On the way"
        android:textSize="13sp"
        android:textStyle="medium"
        android:textColor="#FF9800"/>
    
    <!-- Stage Indicators -->
    <LinearLayout
        android:id="@+id/stageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvStatus"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">
        
        <View
            android:id="@+id/stage0"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#4CAF50"/>
        
        <View
            android:layout_width="20dp"
            android:layout_height="2dp"
            android:background="#CCCCCC"/>
        
        <View
            android:id="@+id/stage1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#4CAF50"/>
        
        <View
            android:layout_width="20dp"
            android:layout_height="2dp"
            android:background="#CCCCCC"/>
        
        <View
            android:id="@+id/stage2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#4CAF50"/>
        
        <View
            android:layout_width="20dp"
            android:layout_height="2dp"
            android:background="#CCCCCC"/>
        
        <View
            android:id="@+id/stage3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#FF9800"/>
        
        <View
            android:layout_width="20dp"
            android:layout_height="2dp"
            android:background="#CCCCCC"/>
        
        <View
            android:id="@+id/stage4"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#CCCCCC"/>
    </LinearLayout>
    
    <!-- Order Items -->
    <TextView
        android:id="@+id/tvOrderItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/stageLayout"
        android:layout_marginTop="6dp"
        android:text="Margherita Pizza, Garlic Bread"
        android:textSize="11sp"
        android:textColor="#666666"
        android:maxLines="2"
        android:ellipsize="end"/>
    
    <!-- Rider Info -->
    <LinearLayout
        android:id="@+id/riderInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvOrderItems"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        
        <ImageView
            android:id="@+id/ivRiderPhoto"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerCrop"/>
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/tvRiderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amit Singh"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
            
            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Near Central Market"
                android:textSize="11sp"
                android:textColor="#999999"/>
        </LinearLayout>
        
        <ImageButton
            android:id="@+id/btnCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_call"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#4CAF50"/>
        
        <ImageButton
            android:id="@+id/btnTrack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_mapmode"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#2196F3"/>
    </LinearLayout>
    
    <!-- Delivery Address -->
    <TextView
        android:id="@+id/tvDeliveryAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/riderInfo"
        android:layout_marginTop="4dp"
        android:drawableStart="@android:drawable/ic_menu_mylocation"
        android:drawablePadding="4dp"
        android:text="123 Main Street, Apt 4B"
        android:textSize="11sp"
        android:textColor="#999999"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"/>
    
</RelativeLayout>
